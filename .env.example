# All keys are optional. With none set, Gully Guessr runs in zero-key Open Mode
# (still Wikimedia Commons street photographs — no street navigation).
# Set at least one key below for navigable street view, then restart `npm run dev`.

# Tier 1 — Google Street View (full street navigation everywhere Street View exists in India).
# Google Cloud console → enable "Maps JavaScript API" (and optionally "Geocoding API"),
# create an API key, and restrict it to your site's HTTP referrers.
VITE_GOOGLE_MAPS_API_KEY=

# Tier 2 — Mapillary free street-level imagery with navigation. Create a client token at
# https://www.mapillary.com/dashboard/developers
VITE_MAPILLARY_ACCESS_TOKEN=

# Accounts + multiplayer — Firebase Auth. Firebase console → Project settings → Your apps → Web app config.
# Enable Email/Password (and optionally Google) under Authentication → Sign-in method.
# Leave blank to run single-player only (no login, no multiplayer).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Only when the game server runs on a different host than the site (e.g. wss://play.example.com).
# By default the browser connects to /ws on the same host, which `npm run dev` and `npm start` both serve.
VITE_GAME_SERVER_URL=
