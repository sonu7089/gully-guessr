    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "three": "^0.185.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.67.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
